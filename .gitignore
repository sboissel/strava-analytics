__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local pyenv pin (CI/Streamlit use 3.11 from config)
.python-version

# CI-managed exports under data/ must stay trackable (Streamlit Cloud + GitLab
# sync). Never ignore `data/` or `data/*` — that makes `git add data/` / even
# `git add data/*.csv` fail with "paths are ignored: data". Only ignore scratch.
data/.cache/
data/*.tmp
data/*.temp

# Secrets and local env
.env
.env.*
*.pem
*.key

.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Python packaging
*.egg-info/
.eggs/
dist/
build/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Streamlit — never commit secrets (config.toml at repo root is OK to track)
**/.streamlit/secrets.toml

# Local debug / scratch artifacts
dashboard/_debug_*.png
*.log
logs/

# Editor / OS
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
