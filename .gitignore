__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local pyenv pin (CI/Streamlit use 3.11 from config)
.python-version

# data/*.csv and highest_activity_id.txt stay tracked: GitLab CI sync commits
# them for Streamlit Cloud. Ignore only local scratch under data/ if added later.
data/*
!data/*.csv
!data/highest_activity_id.txt

# Secrets and local env
.env
.env.*
*.pem
*.key

.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Python packaging
*.egg-info/
.eggs/
dist/
build/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Streamlit — never commit secrets (config.toml at repo root is OK to track)
**/.streamlit/secrets.toml

# Local debug / scratch artifacts
dashboard/_debug_*.png
*.log
logs/

# Editor / OS
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
